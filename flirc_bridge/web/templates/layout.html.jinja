<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <title>{% block title %}{{ settings.instance_name }} - Flirc Bridge{% endblock %}</title>
    <link rel="icon" type="image/png" href="https://flirc.tv/cdn/shop/files/Flat_Head_32x32.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />
    <link rel="stylesheet" href="/static/app.css" />
    {% block head_extra %}{% endblock %}
</head>

<body data-requires-token="{{ 'true' if requires_token else 'false' }}" data-bs-theme="dark" class="bg-dark text-light d-flex flex-column min-vh-100">
    <div id="alerts-root" class="toast-container position-fixed top-0 start-50 translate-middle-x p-3" style="z-index: 1100"></div>
    <header class="border-bottom border-secondary-subtle py-3 mb-4">
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container">
                <a class="navbar-brand fw-semibold" href="/">{{ settings.instance_name }}</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link {% if active_page == 'patterns' %}active{% endif %}" href="/">Patterns</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {% if active_page == 'status' %}active{% endif %}" href="/status">Status</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {% if active_page == 'logs' %}active{% endif %}" href="/logs">Logs</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
        <div class="container">
            <div class="d-flex flex-column flex-lg-row gap-3 align-items-lg-center justify-content-between">
                <div>
                    <p class="text-secondary mb-0 small">
                        MQTT client: {{ settings.mqtt_prefix }} @ {{ settings.mqtt_broker }}:{{ settings.mqtt_port }}
                    </p>
                </div>
                {% if not mqtt_available %}
                <div class="alert alert-warning align-self-start align-self-lg-stretch mb-0 py-2 px-3" role="alert">
                    MQTT bridge is disabled or unavailable. REST API and web UI remain operational.
                </div>
                {% endif %}
            </div>
        </div>
    </header>

    <main class="flex-grow-1 pb-5">
        <div class="container">
            {% block content %}{% endblock %}
        </div>
    </main>

    <footer class="mt-auto border-top border-secondary-subtle py-3">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 text-secondary small">
            <div><a href="https://flirc.com" class="text-secondary text-decoration-none" target="_blank" rel="noopener noreferrer">flirc.com</a></div>
            <div><a href="https://github.com/flirc-labs/flirc-bridge" class="text-secondary text-decoration-none" target="_blank" rel="noopener noreferrer">GitHub</a></div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script id="app-context" type="application/json">
    {{ app_context|tojson }}
  </script>
    <script src="/static/app.js"></script>
    {% block scripts %}{% endblock %}
</body>

</html>