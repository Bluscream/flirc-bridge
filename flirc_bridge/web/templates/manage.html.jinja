{% extends "layout.html.jinja" %}

{% block title %}{{ settings.instance_name }} - Manage · Flirc Bridge{% endblock %}

{% block content %}
<section class="mb-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 text-white mb-0">Manage Patterns</h2>
    <button type="button" class="btn btn-success" onclick="scrollToAddPattern()">Add</button>
  </div>
  {% if not devices %}
  <div class="alert alert-secondary text-secondary-emphasis" role="alert">
    No patterns stored yet.
  </div>
  {% else %}
  <div class="table-responsive">
    <table class="table table-dark table-striped align-middle">
      <thead>
        <tr>
          <th scope="col">Device</th>
          <th scope="col">Action</th>
          <th scope="col">Pattern</th>
          <th scope="col">Updated</th>
          <th scope="col" class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for device in devices %}
          {% if not device.actions %}
          <tr>
            <td class="align-middle">
              <div class="fw-semibold text-white">{{ device.name }}</div>
              {% if device.description %}
              <div class="text-secondary small">{{ device.description }}</div>
              {% endif %}
              <button class="btn btn-sm btn-outline-danger mt-2" onclick='deleteDeviceById({{ device.id|tojson }})'>Delete Device</button>
            </td>
            <td class="text-secondary align-middle">—</td>
            <td class="text-secondary align-middle">—</td>
            <td class="text-secondary align-middle">—</td>
            <td class="text-end align-middle">
              <span class="text-secondary">No actions available</span>
            </td>
          </tr>
          {% else %}
            {% for action in device.actions %}
              {% if not action.patterns %}
              <tr>
                <td class="text-white align-middle">
                  <div class="fw-semibold">{{ device.name }}</div>
                </td>
                <td class="text-white align-middle">
                  <div class="fw-semibold">{{ action.name }}</div>
                </td>
                <td class="text-secondary align-middle">No patterns stored.</td>
                <td class="text-secondary align-middle">—</td>
                <td class="text-end align-middle">
                  <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-outline-danger" onclick='deleteActionById({{ action.id|tojson }})'>Delete Action</button>
                  </div>
                </td>
              </tr>
              {% else %}
                {% for pattern in action.patterns %}
                <tr>
                  <td class="text-white align-middle">
                    <div class="fw-semibold">{{ device.name }}</div>
                  </td>
                  <td class="text-white align-middle">
                    <div class="fw-semibold">{{ action.name }}</div>
                  </td>
                  <td class="text-secondary align-middle">
                    <div><span class="badge bg-secondary">{{ pattern.format|upper }}</span></div>
                    <div class="text-secondary small">repeat {{ pattern.repeat }} · ik {{ pattern.ik }}</div>
                    {% if pattern.data %}
                    <div class="text-secondary small text-truncate" style="max-width: 18rem;">
                      {{ pattern.data|join(', ') }}
                    </div>
                    {% endif %}
                  </td>
                  <td class="text-secondary align-middle">
                    {% if pattern.updated_at %}
                      {{ pattern.updated_at }}
                    {% else %}
                      —
                    {% endif %}
                  </td>
                  <td class="text-end align-middle">
                    <div class="btn-group btn-group-sm" role="group">
                      <button type="button" class="btn btn-outline-success" onclick='sendPatternById({{ pattern.id|tojson }})'>Send</button>
                      <button type="button" class="btn btn-outline-light" onclick='editPattern({{ pattern.id|tojson }})'>Edit</button>
                      <button type="button" class="btn btn-outline-danger" onclick='deletePatternById({{ pattern.id|tojson }})'>Delete</button>
                    </div>
                  </td>
                </tr>
                {% endfor %}
              {% endif %}
            {% endfor %}
          {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
</section>

<section>
  <div class="card bg-body-tertiary border-0 shadow-lg">
    <div class="card-header bg-transparent border-secondary-subtle">
      <h3 class="h5 text-white mb-0">Add or Update Pattern</h3>
    </div>
    <div class="card-body">
      {% if requires_token %}
      <div class="alert alert-info text-info-emphasis" role="alert">
        An access token is required to add, edit, or delete patterns. You will be prompted when needed.
      </div>
      {% endif %}
      <form id="pattern-form" class="row g-3 align-items-end">
        <input type="hidden" id="device-id-field" />
        <input type="hidden" id="action-id-field" />
        <input type="hidden" id="pattern-id-field" />
        <div class="col-12 col-xl-auto flex-grow-1">
          <label for="device" class="form-label">Device</label>
          <input id="device" name="device" class="form-control" placeholder="e.g. Compact Space Heater" required />
        </div>
        <div class="col-12 col-xl-auto flex-grow-1">
          <label for="action" class="form-label">Action</label>
          <input id="action" name="action" class="form-control" placeholder="e.g. Toggle" required />
        </div>
        <div class="col-6 col-xl-auto">
          <label for="pattern-format" class="form-label">Format</label>
          <select id="pattern-format" class="form-select" required>
            <option value="raw">Raw</option>
            <option value="csv">CSV</option>
            <option value="pronto">Pronto</option>
          </select>
        </div>
        <div class="col-6 col-xl-auto">
          <label for="pattern-repeat" class="form-label">Repeat</label>
          <input id="pattern-repeat" type="number" class="form-control" min="1" step="1" value="1" />
        </div>
        <div class="col-6 col-xl-auto">
          <label for="pattern-ik" class="form-label">IK</label>
          <input id="pattern-ik" type="number" class="form-control" min="1" step="1" value="23" />
        </div>
        <div class="col-12">
          <label for="pattern-data" class="form-label">Pattern Data</label>
          <textarea id="pattern-data" rows="6" class="form-control" placeholder="Paste pattern data" required></textarea>
          <div class="form-text text-secondary mt-1">Format auto-detects when possible. Use spaces or commas between values.</div>
        </div>
        <div class="col-12">
          <button type="submit" class="btn btn-success">Save Pattern</button>
        </div>
      </form>
    </div>
  </div>
</section>
{% endblock %}