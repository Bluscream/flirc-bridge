{% extends "layout.html.jinja" %}

{% block title %}{{ settings.instance_name }} - Send · Flirc Bridge{% endblock %}

{% block content %}
<section class="mb-4">
  <div class="card bg-body-tertiary border-0 shadow-lg">
    <div class="card-header bg-transparent border-secondary-subtle">
      <h2 class="h4 text-white mb-0">Send Custom Pattern</h2>
    </div>
    <div class="card-body">
      <form id="custom-send-form" class="row g-3">
        <div class="col-12 col-md-3">
          <label for="custom-format-select" class="form-label">Format</label>
          <select id="custom-format-select" class="form-select">
            <option value="raw">Raw</option>
            <option value="csv">CSV</option>
            <option value="pronto">Pronto</option>
          </select>
        </div>
        <div class="col-6 col-md-2">
          <label for="custom-repeat-input" class="form-label">Repeat</label>
          <input id="custom-repeat-input" type="number" class="form-control" min="1" step="1" value="1" />
        </div>
        <div class="col-6 col-md-2">
          <label for="custom-ik-input" class="form-label">IK</label>
          <input id="custom-ik-input" type="number" class="form-control" min="1" step="1" value="23000" />
        </div>
        <div class="col-12 col-md-5">
          <label for="custom-pattern-input" class="form-label">Pattern Data</label>
          <input id="custom-pattern-input" class="form-control" placeholder="Paste pattern data" autocomplete="off" />
        </div>
        <div class="col-12 col-md-2 d-grid align-self-end">
          <button type="submit" id="custom-send-button" class="btn btn-primary">Send</button>
        </div>
      </form>
      <div class="form-text text-secondary mt-2">
        Paste a pattern to auto-detect its format. Press Enter to send.
      </div>
    </div>
  </div>
</section>

<section>
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 text-white mb-0">Devices</h2>
  </div>
  {% if not devices %}
    <div class="alert alert-secondary text-secondary-emphasis" role="alert">
      No patterns saved yet.
    </div>
  {% else %}
    <div class="vstack gap-4">
      {% for device in devices %}
      <div class="card shadow-lg border-0 bg-body-tertiary">
        <div class="card-header bg-transparent border-secondary-subtle">
          <div class="d-flex flex-column flex-md-row justify-content-between gap-2">
            <div>
              <h3 class="h5 text-white mb-0">{{ device.name }}</h3>
              {% if device.description %}
              <p class="text-secondary mb-0 small">{{ device.description }}</p>
              {% endif %}
            </div>
            <div class="text-secondary small text-md-end">
              <div>ID: <code>{{ device.id }}</code></div>
              {% if device.actions %}
              <div>{{ device.actions|length }} action{{ 's' if device.actions|length != 1 else '' }}</div>
              {% endif %}
            </div>
          </div>
        </div>
        <div class="card-body">
          {% if not device.actions %}
            <p class="text-secondary mb-0">No actions stored.</p>
          {% else %}
            <div class="vstack gap-3">
              {% for action in device.actions %}
              <div class="border border-secondary-subtle rounded-3 p-3 bg-dark-subtle">
                <div class="d-flex flex-column flex-md-row align-items-md-center gap-3">
                  <div class="flex-grow-1">
                    <h4 class="h6 text-white mb-1">{{ action.name }}</h4>
                    {% if action.description %}
                    <p class="text-secondary small mb-0">{{ action.description }}</p>
                    {% endif %}
                    <div class="text-secondary small">
                      ID: <code>{{ action.id }}</code> &middot;
                      {{ action.patterns|length }} pattern{{ 's' if action.patterns|length != 1 else '' }}
                    </div>
                  </div>
                  <div class="d-flex flex-wrap gap-2">
                    <button
                      class="btn btn-outline-primary btn-sm action-send-button"
                      data-action-label="{{ action.name }}"
                      onclick='sendAction({{ device.id|tojson }}, {{ action.id|tojson }})'>
                      Send All Patterns
                    </button>
                  </div>
                </div>
                {% if action.patterns %}
                <div class="mt-3 d-flex flex-wrap gap-2">
                  {% for pattern in action.patterns %}
                  <button
                    class="btn btn-sm btn-outline-light action-send-button"
                    data-action-label="{{ action.name }}"
                    onclick='sendPatternById({{ pattern.id|tojson }})'>
                    {{ pattern.format|upper }} · repeat {{ pattern.repeat }} · ik {{ pattern.ik }}
                  </button>
                  {% endfor %}
                </div>
                {% endif %}
              </div>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
  {% endif %}
</section>
{% endblock %}