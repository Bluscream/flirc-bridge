<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>Flirc Bridge</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />
  <link rel="stylesheet" href="/static/app.css" />
</head>

<body data-requires-token="{{ 'true' if requires_token else 'false' }}" data-bs-theme="dark" class="bg-dark text-light">
  <div id="alerts-root" class="toast-container position-fixed top-0 start-50 translate-middle-x p-3" style="z-index: 1100"></div>
  <header class="border-bottom border-secondary-subtle py-4 mb-4">
    <div class="container">
      <div class="d-flex flex-column flex-lg-row gap-3 align-items-lg-center justify-content-between">
        <div>
          <h1 class="display-6 mb-1 text-white">Flirc Bridge</h1>
          <p class="text-secondary mb-0">
            MQTT client: {{ settings.mqtt_client_id }} @ {{ settings.mqtt_broker }}:{{ settings.mqtt_port }}
          </p>
        </div>
        {% if not mqtt_available %}
        <div class="alert alert-warning align-self-start align-self-lg-stretch mb-0" role="alert">
          MQTT bridge is disabled or unavailable. REST API and web UI remain operational.
        </div>
        {% endif %}
      </div>
    </div>
  </header>

  <main class="pb-5">
    <div class="container">
      <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h2 class="h4 text-white mb-0">Stored Patterns</h2>
        </div>
        {% if not patterns %}
        <div class="alert alert-secondary text-secondary-emphasis" role="alert">
          No patterns saved yet.
        </div>
        {% else %}
        <div class="vstack gap-4">
          {% for device, actions in patterns.items() %}
          <div class="card shadow-lg border-0 bg-body-tertiary">
            <div class="card-header bg-transparent border-secondary-subtle d-flex flex-column flex-md-row gap-3 justify-content-between align-items-md-center">
              <div>
                <h3 class="h5 text-white mb-1">{{ device }}</h3>
                <p class="text-secondary mb-0 small text-uppercase">
                  {{ actions|length }} action{{ 's' if actions|length != 1 else '' }}
                </p>
              </div>
              <button class="btn btn-outline-danger btn-sm align-self-start align-self-md-center" onclick="deleteDevice({{ device|tojson }})">
                Delete Device
              </button>
            </div>
            <div class="card-body">
              {% if not actions %}
              <p class="text-secondary mb-0">No actions stored.</p>
              {% else %}
              <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
                {% for action, formats in actions.items() %}
                <div class="col">
                  <div class="card h-100 bg-dark-subtle border-secondary-subtle shadow-sm action-card">
                    <div class="card-body d-flex flex-column">
                      <div class="mb-3">
                        <h4 class="h6 text-white mb-1">{{ action }}</h4>
                        <span class="badge bg-secondary text-uppercase">
                          {{ formats|length }} format{{ 's' if formats|length != 1 else '' }}
                        </span>
                      </div>
                      <div class="mt-auto d-flex flex-column gap-2">
                        <button class="btn btn-primary w-100" onclick="sendPattern({{ device|tojson }}, {{ action|tojson }})">
                          Send
                        </button>
                        <button class="btn btn-outline-light w-100" onclick="editPattern({{ device|tojson }}, {{ action|tojson }})">
                          Edit
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
                {% endfor %}
              </div>
              {% endif %}
            </div>
          </div>
          {% endfor %}
        </div>
        {% endif %}
      </section>

      <section>
        <div class="card bg-body-tertiary border-0 shadow-lg">
          <div class="card-header bg-transparent border-secondary-subtle">
            <h2 class="h4 text-white mb-0">Add or Update Pattern</h2>
          </div>
          <div class="card-body">
            {% if requires_token %}
            <div class="alert alert-info text-info-emphasis" role="alert">
              An access token is required to add, edit, or delete patterns. You will be prompted when needed.
            </div>
            {% endif %}
            <form id="pattern-form" method="post" action="/api/patterns" enctype="application/json" class="row g-3">
              <div class="col-12 col-md-6">
                <label for="device" class="form-label">Device</label>
                <input id="device" name="device" class="form-control" placeholder="e.g. Compact Space Heater" required />
              </div>
              <div class="col-12 col-md-6">
                <label for="action" class="form-label">Action</label>
                <input id="action" name="action" class="form-control" placeholder="e.g. Toggle" required />
              </div>
              <div class="col-12">
                <label for="formats" class="form-label">Formats JSON</label>
                <textarea id="formats" name="formats" rows="6" class="form-control" placeholder='[{"format": "raw", "data": ["+9000 -4500 ..."]}]' required></textarea>
              </div>
              <div class="col-12">
                <button type="submit" class="btn btn-success">Save Pattern</button>
              </div>
            </form>
          </div>
        </div>
      </section>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
  <script id="app-context" type="application/json">
    {{ {"patterns": patterns, "requiresToken": requires_token}|tojson }}
  </script>
  <script src="/static/app.js"></script>
</body>

</html>